#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
# ps4-rescue-desktop — Guaranteed XFCE4 / Safe-Display Recovery Launcher (Ticket T-009, D-05)
#
# Run from TTY (Ctrl+Alt+F2) whenever KDE Plasma or SDDM shows a black screen:
#   1. Runs HDMI Display Protection Engine recovery (unmutes MN864729 + selects safe mode)
#   2. Ensures Xorg 20-ps4-gpu.conf matches Mesa availability (--auto-safe)
#   3. Launches lightweight XFCE4 recovery desktop (~350 MiB RAM)

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "[1/3] Running PS4 HDMI Display Protection recovery..."
"${REPO_ROOT}/bin/ps4-display-protector" --recover || true

echo "[2/3] Verifying X11 GPU configuration safety..."
if [[ "$(id -u)" -eq 0 ]]; then
    "${REPO_ROOT}/scripts/ps4-mesa-select" --auto-safe || true
fi

if [[ "${1:-}" == "--check-only" ]]; then
    echo "[3/3] Check-only complete; XFCE recovery script verified."
    exit 0
fi

echo "[3/3] Starting guaranteed XFCE4 recovery session..."
if command -v startxfce4 >/dev/null 2>&1; then
    exec dbus-run-session -- startxfce4
else
    echo "startxfce4 not installed on this host; run ps4-doctor for diagnostics:"
    exec "${REPO_ROOT}/bin/ps4-doctor"
fi
