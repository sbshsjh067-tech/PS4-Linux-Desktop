# SPDX-License-Identifier: GPL-2.0-only
# PS4 Linux Desktop — Kernel Configuration Fragment for PS4 Fat (Aeolia & Belize)
# Applied on top of feeRnt/ps4-linux-12xx@8ec5c282abda91f6c2e4014de206105aa7912516 (7.0-Clean)

# --- PS4 Platform & Southbridge (Aeolia / Belize) ---
CONFIG_X86_PS4=y
CONFIG_PS4_DMI_SPOOF=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_XHCI_AEOLIA=y

# --- Firmware Loader (loader prepends liverpool_* ucode in early cpio) ---
CONFIG_FW_LOADER=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y

# --- Graphics: AMDGPU + DRM/KMS + HDMI Bridge MUST be built-in (=y) ---
# Building CONFIG_DRM_AMDGPU=m causes ~60s late init and GFX/SDMA ring illegal
# instruction faults on Liverpool/Gladius!
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_LOAD_EDID_FIRMWARE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# --- USB RootFS & linux.img Loop Support (Decision D-01) ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_OVERLAY_FS=y

# --- Desktop, Systemd, ZRAM, Input & Audio ---
CONFIG_CGROUPS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_INOTIFY_USER=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_ZRAM=m
CONFIG_CRYPTO_LZ4=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_PLAYSTATION=y
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_SONY=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_HDMI=y
