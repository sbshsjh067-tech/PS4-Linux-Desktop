# PS4 Linux Desktop — KDE Plasma Thin Windows-Like Profile (Ticket T-008)
# Target: <= 900 MiB idle RAM, <= 8% idle CPU on 8-core AMD Jaguar @ 1.6 GHz
# Disables blur, wobbly windows, contrast, and slow animations; enforces OpenGL RadeonSI.

[Compositing]
Backend=OpenGL
Enabled=true
GLCore=true
GLPreferBufferSwap=a
LatencyPolicy=Low
WindowsBlockCompositing=true

[KDE]
AnimationDurationFactor=0

[Plugins]
blurEnabled=false
contrastEnabled=false
kwin4_effect_translucencyEnabled=false
wobblywindowsEnabled=false
magiclampEnabled=false
zoomEnabled=false
