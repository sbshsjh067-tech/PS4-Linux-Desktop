[Unit]
Description=PS4 HDMI Display Protection & MN864729 Keep-Alive Daemon (BOOT STAGE 7 & 11)
After=systemd-modules-load.service systemd-udevd.service
Before=display-manager.service sddm.service lightdm.service

[Service]
Type=simple
ExecStartPre=/usr/local/sbin/ps4-mesa-select --auto-safe
ExecStart=/usr/local/bin/ps4-display-protector --daemon --interval 3 --log-dir /var/log/ps4-linux
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
