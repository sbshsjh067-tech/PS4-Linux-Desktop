#!/usr/bin/env python3
"""CLI for the 11-Stage PS4 Safe Boot Verification & Logging Engine (PART 1 §4)."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT / "src"))

from ps4_linux.safe_boot import SafeBootContext, run_safe_boot_pipeline  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="PS4 11-Stage Safe Boot Verification Engine")
    ap.add_argument("--layout", choices=["usb_fat32", "internal_ftp"], default="usb_fat32")
    ap.add_argument("--southbridge", choices=["aeolia", "belize", "baikal"], default="belize")
    ap.add_argument("--firmware", default="13.52")
    ap.add_argument("--usb-boot-dir", type=Path, default=None)
    ap.add_argument("--internal-boot-dir", type=Path, default=None)
    ap.add_argument("--payload", type=Path, default=None)
    ap.add_argument("--bzimage", type=Path, default=None)
    ap.add_argument("--initramfs", type=Path, default=None)
    ap.add_argument("--rootfs-img", type=Path, default=None)
    ap.add_argument("--sysfs-root", type=Path, default=Path("/sys"))
    ap.add_argument("--log-dir", type=Path, default=None)
    ap.add_argument("--live-ps4", action="store_true", help="Enforce strict live PS4 hardware checks")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)

    ctx = SafeBootContext(
        layout=args.layout,
        southbridge=args.southbridge,
        firmware_version=args.firmware,
        usb_boot_dir=args.usb_boot_dir,
        internal_boot_dir=args.internal_boot_dir,
        payload_path=args.payload,
        bzimage_path=args.bzimage,
        initramfs_path=args.initramfs,
        rootfs_image_path=args.rootfs_img,
        sysfs_root=args.sysfs_root,
        is_live_ps4=args.live_ps4,
    )
    rep = run_safe_boot_pipeline(ctx, log_dir=args.log_dir)

    if args.json:
        print(json.dumps(rep.to_dict(), indent=2))
    else:
        print("=== PS4 11-STAGE SAFE BOOT ARCHITECTURE REPORT ===")
        for st in rep.stages:
            ids = f" [{','.join(st.issue_ids)}]" if st.issue_ids else ""
            print(f"[{st.status:4s}] {st.stage_name}{ids}")
            print(f"       -> {st.summary}")
        print("-" * 66)
        print(f"OVERALL STATUS        : {rep.overall_status}")
        print(f"LAST SUCCESSFUL STAGE : {rep.last_successful_stage or 'NONE'}")
        print(f"FIRST FAILED STAGE    : {rep.first_failed_stage or 'NONE'}")

    return 1 if rep.overall_status == "FAIL" else 0


if __name__ == "__main__":
    raise SystemExit(main())
