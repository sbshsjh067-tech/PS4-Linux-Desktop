#!/usr/bin/env python3
"""CLI & Daemon for the PS4 HDMI Display Protection Engine (PART 1 §3)."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys
import time

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT / "src"))

from ps4_linux.display_protector import run_display_protection_pass  # noqa: E402
from ps4_linux.edid import DisplayMode  # noqa: E402


def _parse_mode_arg(raw: str) -> DisplayMode:
    # e.g. "1920x1080@60" or "1280x720@60"
    res, _, hz_part = raw.partition("@")
    inter = res.endswith("i")
    res_clean = res.rstrip("i")
    w_s, h_s = res_clean.split("x", 1)
    hz = int(hz_part) if hz_part else 60
    return DisplayMode(int(w_s), int(h_s), hz, inter, False, 0, "user_request")


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="PS4 HDMI Display Protection & EDID Safe-Mode Engine")
    ap.add_argument("--sysfs-root", type=Path, default=Path("/sys"), help="DRM sysfs root (default: /sys)")
    ap.add_argument("--request-mode", type=str, default="", help="Optional candidate mode WxH@Hz to validate")
    ap.add_argument("--fallback-tier", type=int, default=0, help="Fallback tier index (0=720p60, 1=1024x768, 2=480p, 3=640x480)")
    ap.add_argument("--recover", action="store_true", help="Execute bridge unmute + KMS/RandR safe mode recovery")
    ap.add_argument("--daemon", action="store_true", help="Continuously monitor HDMI bridge & connector health")
    ap.add_argument("--interval", type=float, default=3.0, help="Daemon poll interval in seconds (default: 3.0)")
    ap.add_argument("--dry-run", action="store_true", help="Never mutate hardware/RandR state")
    ap.add_argument("--log-dir", type=Path, default=None, help="Directory to persist JSON state & log")
    ap.add_argument("--json", action="store_true", help="Print full JSON report")
    args = ap.parse_args(argv)

    req_mode = _parse_mode_arg(args.request_mode) if args.request_mode else None

    while True:
        rep = run_display_protection_pass(
            sysfs_root=args.sysfs_root,
            requested_mode=req_mode,
            fallback_tier=args.fallback_tier,
            perform_recovery=(args.recover or args.daemon),
            dry_run=args.dry_run,
            log_dir=args.log_dir,
        )
        if args.json:
            print(json.dumps(rep.to_dict(), indent=2))
        else:
            print(f"=== PS4 HDMI DISPLAY PROTECTION REPORT ({rep.timestamp}) ===")
            print(f"Active Connector     : {rep.active_connector or 'NONE'}")
            print(f"Supported Resolutions: {', '.join(rep.supported_resolutions) or 'NONE (EDID unavailable)'}")
            print(f"Supported Refresh Hz : {', '.join(str(r) for r in rep.supported_refresh_rates) or 'NONE'}")
            print(f"Selected Safe Mode   : {rep.decision.selected_mode.kms_mode_str} ({rep.decision.selected_mode.source})")
            print(f"Standby Fallback Mode: {rep.decision.fallback_mode.kms_mode_str}")
            print(f"Kernel KMS Video Arg : {rep.decision.kernel_video_arg}")
            print(f"Reason               : {rep.decision.reason}")
            print(f"HDMI Bridge Chip     : {rep.bridge_health.bridge_chip} (unmuted={rep.bridge_health.unmute_applied})")
            print(f"DRM/AMDGPU Errors    : {len(rep.drm_errors)}")
            for w in rep.decision.warnings:
                print(f"  [WARN] {w}")
            for act in rep.recovery_actions:
                print(f"  [RECOVERY] {act}")

        if not args.daemon:
            return 0
        time.sleep(max(1.0, args.interval))


if __name__ == "__main__":
    raise SystemExit(main())
