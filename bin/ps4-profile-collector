#!/usr/bin/env python3
"""CLI for Ticket T-001 Profile Collector (`~/.config/ps4/profile.yaml` + `~/ps4-report.txt`)."""

from __future__ import annotations

import argparse
from pathlib import Path
import sys

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT / "src"))

from ps4_linux.doctor import collect_console_profile  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="PS4 Hardware & Software Profile Collector (T-001)")
    ap.add_argument("--output-yaml", type=Path, default=Path.home() / ".config/ps4/profile.yaml")
    ap.add_argument("--output-report", type=Path, default=Path.home() / "ps4-report.txt")
    ap.add_argument("--layout", choices=["usb_fat32", "internal_ftp"], default="usb_fat32")
    ap.add_argument("--bzimage", type=Path, default=None)
    ap.add_argument("--initramfs", type=Path, default=None)
    ap.add_argument("--rootfs-img", type=Path, default=None)
    ap.add_argument("--sysfs-root", type=Path, default=Path("/sys"))
    ap.add_argument("--mesa-prefix", type=Path, default=Path("/opt/ps4-mesa"))
    args = ap.parse_args(argv)

    prof = collect_console_profile(
        output_yaml=args.output_yaml,
        output_report_txt=args.output_report,
        layout=args.layout,
        bzimage_path=args.bzimage,
        initramfs_path=args.initramfs,
        rootfs_image_path=args.rootfs_img,
        sysfs_root=args.sysfs_root,
        mesa_prefix=args.mesa_prefix,
    )
    print(f"Wrote profile YAML : {args.output_yaml}")
    print(f"Wrote text report  : {args.output_report}")
    print(f"Detected GPU       : {prof['hardware_checks']['gpu_pci_id']}")  # type: ignore[index]
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
